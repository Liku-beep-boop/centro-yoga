---
import Base from '../layouts/Base.astro';
import ListaEventos from '../components/ListaEventos.astro';
import TarjetaEntrada from '../components/TarjetaEntrada.astro';
import sitio from '../data/sitio.json';
import libro from '../data/libro.json';
import { getEntry } from 'astro:content';
import { eventosFuturos, entradasPublicadas, waLink } from '../lib/utils';

const sobre = await getEntry('paginas', 'sobre');
const formacion = await getEntry('paginas', 'formacion');
const eventos = await eventosFuturos(3);
const entradas = await entradasPublicadas(3);
const wa = waLink(sitio.whatsapp, sitio.whatsapp_mensaje);
---

<Base>
  <section class="hero" style={sitio.hero_imagen ? `--hero-img: url('${sitio.hero_imagen}')` : undefined}>
    <div class="contenedor">
      <div class="hero__contenido">
        <span class="eyebrow">Yoga · Meditación · Formación</span>
        <h1>{sitio.eslogan}</h1>
        <p class="lead">{sitio.descripcion}</p>
        <div class="acciones">
          <a href="/horarios" class="btn btn--primario">Ver horarios</a>
          {wa && <a href={wa} class="btn btn--borde" target="_blank" rel="noopener">Consultar por WhatsApp</a>}
        </div>
      </div>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor dos-col">
      <div>
        <span class="eyebrow">Quién soy</span>
        <h2>{sobre?.data.titulo}</h2>
        {sobre?.data.subtitulo && <p class="lead">{sobre.data.subtitulo}</p>}
        <a href="/sobre" class="btn btn--borde">Conocer la historia</a>
      </div>
      {sobre?.data.imagen ? (
        <img src={sobre.data.imagen} alt="" class="imagen-redonda" loading="lazy" />
      ) : (
        <div class="decoracion" aria-hidden="true"></div>
      )}
    </div>
  </section>

  <section class="seccion seccion--alt">
    <div class="contenedor">
      <div class="encabezado-seccion">
        <span class="eyebrow">Agenda</span>
        <h2>Próximos talleres y encuentros</h2>
      </div>
      <ListaEventos eventos={eventos} />
      <p style="margin-top: 28px"><a href="/horarios" class="btn btn--borde">Ver grilla semanal de clases</a></p>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor grid grid--2 destacados">
      <div class="destacado tarjeta">
        <span class="eyebrow">Formación</span>
        <h2>{formacion?.data.titulo}</h2>
        {formacion?.data.subtitulo && <p>{formacion.data.subtitulo}</p>}
        <a href="/formacion" class="btn btn--primario">Ver la formación</a>
      </div>
      <div class="destacado tarjeta libro-teaser">
        {libro.portada && <img src={libro.portada} alt={`Portada de ${libro.titulo}`} loading="lazy" />}
        <div>
          <span class="eyebrow">El libro</span>
          <h2>{libro.titulo}</h2>
          {libro.subtitulo && <p>{libro.subtitulo}</p>}
          <a href="/libro" class="btn btn--borde">Conocer el libro</a>
        </div>
      </div>
    </div>
  </section>

  {entradas.length > 0 && (
    <section class="seccion seccion--alt">
      <div class="contenedor">
        <div class="encabezado-seccion">
          <span class="eyebrow">Blog</span>
          <h2>Últimas entradas</h2>
        </div>
        <div class="grid grid--3">
          {entradas.map((e) => <TarjetaEntrada entrada={e} />)}
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  .hero {
    position: relative;
    padding: 72px 0 80px;
    background:
      linear-gradient(rgba(250, 246, 239, 0.78), rgba(250, 246, 239, 0.9)),
      var(--hero-img, none) center / cover no-repeat,
      radial-gradient(circle at 80% 20%, rgba(217, 150, 43, 0.3), transparent 45%),
      radial-gradient(circle at 15% 85%, rgba(95, 122, 100, 0.25), transparent 45%),
      var(--crema-2);
    overflow: hidden;
  }
  @media (min-width: 720px) { .hero { padding: 128px 0 136px; } }
  .hero__contenido { position: relative; max-width: 820px; }
  .hero .lead { margin-bottom: 28px; }

  .dos-col { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 860px) { .dos-col { grid-template-columns: 1.2fr 1fr; } }
  .decoracion {
    aspect-ratio: 1;
    max-width: 360px;
    width: 100%;
    margin: 0 auto;
    border-radius: 50%;
    background:
      radial-gradient(circle, transparent 38%, rgba(181, 101, 58, 0.15) 39%, transparent 41%),
      radial-gradient(circle, transparent 54%, rgba(217, 150, 43, 0.2) 55%, transparent 57%),
      radial-gradient(circle, rgba(181, 101, 58, 0.85) 0 22%, transparent 23%),
      var(--crema-2);
  }

  .destacado { padding: 32px 28px; }
  .destacado h2 { font-size: 2rem; }
  .libro-teaser { display: flex; gap: 24px; align-items: flex-start; }
  .libro-teaser img { width: 120px; border-radius: 6px; box-shadow: var(--sombra); flex-shrink: 0; }
</style>
