---
import '../styles/global.css';
import sitio from '../data/sitio.json';
import { waLink } from '../lib/utils';

interface Props {
  titulo?: string;
  descripcion?: string | null;
  imagen?: string | null;
}

const { titulo, descripcion, imagen } = Astro.props;
const tituloCompleto = titulo ? `${titulo} · ${sitio.nombre}` : `${sitio.nombre} — ${sitio.eslogan}`;
const desc = descripcion || sitio.descripcion;
const ogImagen = imagen || sitio.hero_imagen;
const wa = waLink(sitio.whatsapp, sitio.whatsapp_mensaje);

const nav = [
  { href: '/horarios', texto: 'Horarios' },
  { href: '/precios', texto: 'Precios' },
  { href: '/formacion', texto: 'Formación' },
  { href: '/sobre', texto: 'Quién soy' },
  { href: '/libro', texto: 'El libro' },
  { href: '/blog', texto: 'Blog' },
  { href: '/contacto', texto: 'Contacto' },
];
const ruta = Astro.url.pathname.replace(/\/$/, '') || '/';
const activo = (href: string) => ruta === href || ruta.startsWith(href + '/');
const anio = new Date().getFullYear();
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={desc} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={desc} />
    <meta property="og:locale" content="es_AR" />
    {ogImagen && <meta property="og:image" content={new URL(ogImagen, Astro.site)} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Nunito+Sans:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="cabecera">
      <div class="contenedor cabecera__fila">
        <a href="/" class="marca">
          <img src="/favicon.svg" alt="" width="36" height="36" />
          <span>{sitio.nombre}</span>
        </a>
        <button class="menu-btn" aria-expanded="false" aria-controls="menu-principal">
          <span class="sr-only">Abrir menú</span>
          <span class="menu-btn__barra"></span>
          <span class="menu-btn__barra"></span>
          <span class="menu-btn__barra"></span>
        </button>
        <nav id="menu-principal" class="nav" aria-label="Principal">
          {nav.map((item) => (
            <a href={item.href} class:list={['nav__link', { 'nav__link--activo': activo(item.href) }]}>
              {item.texto}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="pie">
      <div class="contenedor pie__grid">
        <div>
          <p class="pie__marca">{sitio.nombre}</p>
          <p>{sitio.eslogan}</p>
        </div>
        <div>
          <p class="pie__titulo">Visitanos</p>
          {sitio.direccion && <p>{sitio.direccion}</p>}
          {sitio.email && <p><a href={`mailto:${sitio.email}`}>{sitio.email}</a></p>}
        </div>
        <div>
          <p class="pie__titulo">Seguinos</p>
          <p class="pie__redes">
            {sitio.instagram && <a href={sitio.instagram} target="_blank" rel="noopener">Instagram</a>}
            {sitio.facebook && <a href={sitio.facebook} target="_blank" rel="noopener">Facebook</a>}
            {sitio.youtube && <a href={sitio.youtube} target="_blank" rel="noopener">YouTube</a>}
            {wa && <a href={wa} target="_blank" rel="noopener">WhatsApp</a>}
          </p>
        </div>
      </div>
      <div class="contenedor pie__legal">© {anio} {sitio.nombre}</div>
    </footer>

    {wa && (
      <a href={wa} class="wa-flotante" target="_blank" rel="noopener" aria-label="Escribinos por WhatsApp">
        <svg viewBox="0 0 32 32" width="30" height="30" aria-hidden="true">
          <path
            fill="currentColor"
            d="M16 3C9 3 3.3 8.6 3.3 15.6c0 2.2.6 4.4 1.7 6.3L3.2 28.8l7.1-1.8c1.8 1 3.8 1.5 5.8 1.5 7 0 12.7-5.7 12.7-12.7C28.8 8.6 23 3 16 3zm0 23.2c-1.9 0-3.7-.5-5.3-1.4l-.4-.2-4.2 1.1 1.1-4.1-.3-.4c-1-1.7-1.6-3.6-1.6-5.6C5.3 9.8 10.1 5.1 16 5.1s10.6 4.8 10.6 10.6S21.9 26.2 16 26.2zm5.8-7.9c-.3-.2-1.9-.9-2.2-1-.3-.1-.5-.2-.7.2-.2.3-.8 1-1 1.2-.2.2-.4.2-.7.1-.3-.2-1.3-.5-2.6-1.6-1-.9-1.6-1.9-1.8-2.2-.2-.3 0-.5.1-.7l.5-.6c.2-.2.2-.4.3-.6.1-.2 0-.4 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.2 1.1-1.2 2.8s1.2 3.3 1.4 3.5c.2.2 2.4 3.6 5.7 5 .8.3 1.4.5 1.9.7.8.3 1.5.2 2.1.1.6-.1 1.9-.8 2.2-1.5.3-.7.3-1.4.2-1.5-.1-.2-.3-.3-.6-.4z"
          ></path>
        </svg>
      </a>
    )}

    <script>
      const btn = document.querySelector('.menu-btn');
      const nav = document.getElementById('menu-principal');
      btn?.addEventListener('click', () => {
        const abierto = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!abierto));
        nav?.classList.toggle('nav--abierto', !abierto);
      });
    </script>
  </body>
</html>

<style>
  .cabecera {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(250, 246, 239, 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--arena);
  }
  .cabecera__fila { display: flex; align-items: center; justify-content: space-between; height: 68px; }
  .marca {
    display: flex; align-items: center; gap: 10px;
    font-family: var(--serif); font-size: clamp(1.05rem, 4.2vw, 1.4rem); font-weight: 600;
    line-height: 1.1; color: var(--tinta); text-decoration: none;
  }
  .marca img { flex-shrink: 0; }
  .marca:hover { color: var(--tinta); }

  .menu-btn {
    display: flex; flex-direction: column; gap: 5px;
    background: none; border: 0; padding: 10px; cursor: pointer;
  }
  .menu-btn__barra { width: 24px; height: 2px; background: var(--tinta); border-radius: 2px; }

  .nav {
    display: none;
    position: absolute; top: 68px; left: 0; right: 0;
    flex-direction: column;
    background: var(--crema);
    border-bottom: 1px solid var(--arena);
    padding: 8px 16px 20px;
  }
  .nav--abierto { display: flex; }
  .nav__link {
    padding: 12px 4px; text-decoration: none; color: var(--tinta);
    font-weight: 600; border-bottom: 1px solid var(--arena);
  }
  .nav__link--activo { color: var(--terracota); }

  @media (min-width: 1140px) {
    .menu-btn { display: none; }
    .nav {
      display: flex; position: static; flex-direction: row; gap: 4px;
      background: none; border: 0; padding: 0;
    }
    .nav__link { border: 0; padding: 8px 12px; border-radius: 999px; font-size: 0.95rem; }
    .nav__link:hover { background: var(--crema-2); color: var(--terracota-osc); }
  }

  .pie { background: var(--tinta); color: #e9e2d6; padding: 56px 0 24px; margin-top: 0; }
  .pie a { color: #f3d8a8; }
  .pie__grid { display: grid; gap: 32px; }
  @media (min-width: 720px) { .pie__grid { grid-template-columns: 2fr 1.5fr 1fr; } }
  .pie__marca { font-family: var(--serif); font-size: 1.6rem; color: #fff; margin-bottom: 0.2em; }
  .pie__titulo { font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; font-size: 0.8rem; color: #c9bba5; }
  .pie__redes { display: flex; flex-direction: column; gap: 4px; }
  .pie__legal { margin-top: 40px; padding-top: 20px; border-top: 1px solid #4a453e; font-size: 0.85rem; color: #a99d8b; }

  .wa-flotante {
    position: fixed; right: 18px; bottom: 18px; z-index: 60;
    width: 58px; height: 58px; border-radius: 50%;
    display: grid; place-items: center;
    background: #25d366; color: #fff;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.2);
    transition: transform 0.2s;
  }
  .wa-flotante:hover { transform: scale(1.06); color: #fff; }
</style>
